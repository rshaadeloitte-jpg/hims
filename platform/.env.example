# Dev-only environment template. Copy to .env and override.
# NEVER commit .env or real credentials (MIG-063).

# PostgreSQL (local dev, optional — services default to remote DEV_DB_* below)
POSTGRES_USER=ihms
POSTGRES_PASSWORD=ihms-dev-only

# Remote dev Postgres (DEV_DB_*) — used by all services via SPRING_DATASOURCE_URL override
DEV_DB_HOST=10.68.61.102
DEV_DB_PORT=5432
DEV_DB_NAME=hims
DEV_DB_USERNAME=postgres
DEV_DB_PASSWORD=TMSProduct1234

# Kafka and Redis are retired: events use ihms_eventbus and caching uses the
# UNLOGGED ihms_cache.app_cache, both on the PostgreSQL above.

# Remote Solr (external)
SOLR_BASE_URL=http://10.70.233.216:8983
SEARCH_BACKEND=solr