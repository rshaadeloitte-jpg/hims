# Frontend runtime configuration (copy to .env for local overrides)
# Vite only exposes VITE_-prefixed variables to the client bundle.
# Defaults below match the DEV-ONLY basic-auth profile of the reference-service
# (Spring profile `dev`; user devops / password from env, default devops-dev-only).
VITE_API_BASE=/api
VITE_API_USERNAME=devops
VITE_API_PASSWORD=devops-dev-only
# DEV-ONLY basic auth switch (red-team F-8): the Authorization header is only
# ever attached in dev-mode builds (import.meta.env.DEV) and only while this
# flag is not "false". Production builds NEVER send it, regardless of .env.
# Set VITE_ENABLE_DEV_BASIC=false to disable even in `vite dev`.
VITE_ENABLE_DEV_BASIC=true
